# Blueprint Studio — environment variables
# Copy to .env. With nothing filled in, the app runs in MOCK mode (heuristic agents).

# --- Azure OpenAI (agents) -------------------------------------------------
# Azure AI Foundry / Azure OpenAI resource endpoint, e.g. https://my-res.openai.azure.com
AZURE_OPENAI_ENDPOINT= "https://ai-anich-test.openai.azure.com/"
AZURE_OPENAI_API_KEY= 7f4898f6f9314dcf9f94468109ea504b
# Your model deployment name (e.g. a gpt-4.1 or gpt-4o deployment)
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra

# SLNG — one key covers both STT and TTS
SLNG_API_KEY=slng_cu_opvAKg53mSyfLhaOx6S2zsaGCvwJD52y7YrlCmVm
SLNG_BASE_URL=api.slng.ai
# Routes to the nearest EU datacenter via X-World-Part-Override (ap | eu | na)
SLNG_WORLD_PART=eu
# STT: Deepgram Nova 3 on SLNG (alternative: reson8/reson8stt:v1). The session
# language (avatars.yaml) is passed to whichever model is set; check coverage for ca.
SLNG_STT_MODEL=deepgram/nova:3
# TTS: Cartesia Sonic 3 (init: linear16 @ 24 kHz). Voices are per avatar, see avatars.yaml.
SLNG_TTS_MODEL=cartesia/sonic:3
SLNG_TTS_ENCODING=linear16
SLNG_TTS_SAMPLE_RATE=24000

# --- Azure AI Speech (narrator voice, optional) ---------------------------
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE_ID=en-US-AvaMultilingualNeural

# --- Azure Cosmos DB (run history, optional; needs `uv sync --extra cosmos`)
COSMOS_ENDPOINT=https://also-hackaton.documents.azure.com:443/
COSMOS_KEY=HJreVCIALXFrnrjsJzpXgmJm9pXQ1W4Gkt13Z9iTChxWocqLXwQSd4LBpT5seE2iBvKwEDwfe7BzACDbLNo0fg==
COSMOS_DATABASE=ALSO-Hackaton
COSMOS_CONTAINER=ALSO-Hackaton-1

# --- Video avatar (optional; lip-syncs the narrator, so it needs Azure Speech)
# none | anam
AVATAR_PROVIDER=none
# Host from avatars.yaml (voice + Anam avatar); empty uses its default_avatar
AVATAR_ID=
# Needs `uv sync --extra anam`. Key and avatar id from https://lab.anam.ai
ANAM_API_KEY=NGMwNjhhODItZDk3Ny00ZGM2LWI3NzEtMTY1MDI3YzZlZWY3OkRNekJaWnJmakI5TW1DUnFZWXhVbVlHdHVINnpVVGlzbWxPTDJHYVdEeWc9
ANAM_AVATAR_ID=b281cadc-9cad-4450-a654-05e733d4320e
# 1 lets Anam record sessions for replay in Anam Lab
ANAM_SESSION_REPLAY=0

# Force mock mode even when keys are present
BLUEPRINT_MOCK=0
